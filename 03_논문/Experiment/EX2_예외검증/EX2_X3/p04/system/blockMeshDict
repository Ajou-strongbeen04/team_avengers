/*--------------------------------*- C++ -*----------------------------------*\
| EX2 파일럿 · 직육면체 47x21x21 cm (z-상향: 바닥 z=0, 자유수면 z=Lz)          |
|  균일 ~4.4mm (≈249k). 플룸 r=10mm ≈ 4.5셀(파일럿 타이밍용).                  |
|  ※ 본 스윕은 topoSet+refineMesh로 플룸을 2.5mm(8셀)로 세분(GCI로 확정).       |
\*---------------------------------------------------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

Lx  0.47;   // 가로(최장변)
Ly  0.21;   // 세로
Lz  0.21;      // 수위(가변)

nx  84;
ny  37;
nz  37;      // dz = 5.676 mm

vertices
(
    (0    0    0 )
    ($Lx  0    0 )
    ($Lx  $Ly  0 )
    (0    $Ly  0 )
    (0    0    $Lz)
    ($Lx  0    $Lz)
    ($Lx  $Ly  $Lz)
    (0    $Ly  $Lz)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1)
);

edges ();

boundary
(
    bottom
    {
        type wall;
        faces ( (0 3 2 1) );
    }
    top
    {
        type patch;                 // 자유수면
        faces ( (4 5 6 7) );
    }
    walls
    {
        type wall;
        faces
        (
            (0 1 5 4)
            (2 3 7 6)
            (1 2 6 5)
            (3 0 4 7)
        );
    }
);

mergePatchPairs ();

// ************************************************************************* //
