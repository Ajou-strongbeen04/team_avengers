/*--------------------------------*- C++ -*----------------------------------*\
| EX1 검증케이스 · 직육면체 L:B:d = 2:1:1  (기본: L=0.4, B=d=0.2, z-상향)      |
|  다른 크기는 아래 Lx/Ly/Lz 와 셀수(nx/ny/nz)만 바꾸면 됨 (run_sweep.sh 참조) |
|  기본 셀 ~4mm → 플룸 r=10mm ≈ 2.5셀(스크리닝용). 대형 크기는 플룸 국부세분 필요 |
\*---------------------------------------------------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object blockMeshDict; }
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

Lx  0.20;
Ly  0.1000;
Lz  0.1000;

nx  100;
ny  50;
nz  50;

vertices
(
    (0    0    0 )
    ($Lx  0    0 )
    ($Lx  $Ly  0 )
    (0    $Ly  0 )
    (0    0    $Lz)
    ($Lx  0    $Lz)
    ($Lx  $Ly  $Lz)
    (0    $Ly  $Lz)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1)
);

edges ();

boundary
(
    bottom
    {
        type wall;
        faces ( (0 3 2 1) );
    }
    top
    {
        type patch;                 // 자유수면(Robin BC 부착 위해 patch)
        faces ( (4 5 6 7) );
    }
    walls
    {
        type wall;
        faces
        (
            (0 1 5 4)
            (2 3 7 6)
            (1 2 6 5)
            (3 0 4 7)
        );
    }
);

mergePatchPairs ();

// ************************************************************************* //
