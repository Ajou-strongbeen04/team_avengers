/*--------------------------------*- C++ -*----------------------------------*\
| EX2 파일럿 · Stage A 유동(pimpleFoam, 과도 URANS) — 타이밍 측정용            |
|  DO는 여기서 안 품(Stage B에서 동결 평균유동 위 scalarTransport).            |
|  fieldAverage로 UMean/pMean/nut·k·omegaMean/phiMean 누적 → Stage B 입력.      |
|  준정상 도달 후 timeStart부터 평균. adjustTimeStep(maxCo 1)로 dt 자동.        |
\*---------------------------------------------------------------------------*/
FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       latestTime;     // warm-start/재시작 지원
startTime       0;
stopAt          endTime;
endTime         200;            // 물리시간[s] = 스핀업 40 + 평균창 160
                                //  2026-07-20 [C안] 200 유지 확정.
                                //  120s 단축안(비용 40%↓)은 검토했으나 기각:
                                //  선행 완료 123케이스가 200s라 평균창 혼재로 인한
                                //  관측잡음(SEM 4.4~5.2% → 6.3~7.3%) 유입을 피함.
                                //  비용은 Spot 전환(온디맨드 대비 ~1/3)으로 해결.
                                //  ※ 변경 시 batch/worker.sh 의 END 와 반드시 동조.

deltaT          0.005;
adjustTimeStep  yes;
maxCo           1.0;
maxDeltaT       0.02;

writeControl    adjustableRunTime;
writeInterval   20;             // [s] 스냅샷 (purgeWrite로 최소 유지)
purgeWrite      3;
writeCompression on;
writeFormat     ascii;          // [C안] 유지. 선행 123케이스와 동일 포맷
                                //  (binary 전환은 pyvista 후처리 호환 리스크 대비 이득 미미)
writePrecision  8;
timeFormat      general;
runTimeModifiable yes;

libs            ("libfieldFunctionObjects.so" "libsampling.so");

functions
{
    // ---- 시간평균장(솔버가 직접 누적) : Stage B DO의 동결 입력 ----
    fieldAverage1
    {
        type            fieldAverage;
        libs            (fieldFunctionObjects);
        timeStart       40;         // 준정상 도달 후(파일럿서 확인·조정)
        writeControl    writeTime;
        fields
        (
            U     { mean on; prime2Mean on; base time; }
            p     { mean on; prime2Mean off; base time; }
            k     { mean on; prime2Mean off; base time; }
            omega { mean on; prime2Mean off; base time; }
            nut   { mean on; prime2Mean off; base time; }
            phi   { mean on; prime2Mean off; base time; }
        );
    }

    // ---- 프로브 시계열(수렴/Strouhal 판정, 실측 대조) ----
    //  ※ 폭기위치가 이동하므로 도메인 전역(4코너+중앙, 표/중/저) 기본값.
    //     최종 격자는 검증 위치 확정 시 재조정.
    probes1
    {
        type            probes;
        libs            (sampling);
        writeControl    timeStep;
        writeInterval   10;
        fields          (U p);
        probeLocations
        (
            (0.235 0.110 0.105)   // pos0 중앙 중층(고정 기준)
            (0.235 0.110 0.18)    // pos1 중앙 표층
            (0.235 0.110 0.03)    // pos2 중앙 저층
            (0.035 0.175 0.18)    // pos3 근플룸 횡측 표
            (0.035 0.175 0.105)   // pos4 근플룸 횡측 중
            (0.035 0.175 0.03)    // pos5 근플룸 횡측 저
            (0.235 0.035 0.18)    // pos6 긴벽 하류 표
            (0.235 0.035 0.105)   // pos7 긴벽 하류 중
            (0.235 0.035 0.03)    // pos8 긴벽 하류 저
            (0.435 0.175 0.18)    // pos9 최원코너 표
            (0.435 0.175 0.105)   // pos10 최원코너 중
            (0.435 0.175 0.03)    // pos11 최원코너 저(dead-spot)
        );
    }

    // ---- 순간 최저/최고(최악 위험 추적, DO는 Stage B에서) ----
    minMaxU
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        fields          (U p);
        writeControl    timeStep;
        writeInterval   20;
    }
}

// ************************************************************************* //
